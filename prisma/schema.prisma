// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SchemaNamespace {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  metadata    Json?
  status      NamespaceStatus @default(active)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schemas        SchemaDefinition[]
  glossaryTerms  GlossaryTerm[]
  tags           Tag[]

  @@map("schema_namespaces")
}

model SchemaDefinition {
  id            String   @id @default(cuid())
  namespaceId   String
  version       String
  type          SchemaType
  contentJson   Json
  author        String?
  status        SchemaStatus @default(draft)
  isDeprecated  Boolean @default(false)
  deprecatedAt  DateTime?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  namespace     SchemaNamespace @relation(fields: [namespaceId], references: [id], onDelete: Cascade)
  validations   SchemaValidation[]
  tags          Tag[]
  relationships SchemaRelationship[] @relation("SourceSchema")
  referencedBy  SchemaRelationship[] @relation("TargetSchema")

  @@unique([namespaceId, version])
  @@index([namespaceId, status])
  @@index([status, isDeprecated])
  @@map("schema_definitions")
}

model GlossaryTerm {
  id          String   @id @default(cuid())
  namespaceId String
  term        String
  definition  String
  aliasesJson Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  namespace SchemaNamespace @relation(fields: [namespaceId], references: [id], onDelete: Cascade)

  @@unique([namespaceId, term])
  @@map("glossary_terms")
}

model Tag {
  id          String   @id @default(cuid())
  name        String
  color       String?
  description String?
  createdAt   DateTime @default(now())

  namespaces SchemaNamespace[]
  schemas    SchemaDefinition[]

  @@unique([name])
  @@map("tags")
}

model SchemaValidation {
  id             String   @id @default(cuid())
  schemaId       String
  isValid        Boolean
  errors         Json?
  warnings       Json?
  validatedAt    DateTime @default(now())
  validatorType  String
  validatorVersion String?

  schema SchemaDefinition @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@index([schemaId, validatedAt])
  @@map("schema_validations")
}

model ChangeLog {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  action         ChangeAction
  changes        Json?
  performedBy    String?
  performedAt    DateTime @default(now())
  metadata       Json?

  @@index([entityType, entityId])
  @@index([performedAt])
  @@map("change_logs")
}

model SchemaRelationship {
  id              String   @id @default(cuid())
  sourceSchemaId  String
  targetSchemaId  String
  relationshipType RelationType
  description     String?
  createdAt       DateTime @default(now())

  sourceSchema SchemaDefinition @relation("SourceSchema", fields: [sourceSchemaId], references: [id], onDelete: Cascade)
  targetSchema SchemaDefinition @relation("TargetSchema", fields: [targetSchemaId], references: [id], onDelete: Cascade)

  @@unique([sourceSchemaId, targetSchemaId, relationshipType])
  @@map("schema_relationships")
}

enum SchemaType {
  json_schema
  openapi
  avro
  protobuf
  graphql
  other
}

enum SchemaStatus {
  draft
  review
  approved
  published
  deprecated
  archived
}

enum NamespaceStatus {
  active
  archived
}

enum ChangeAction {
  created
  updated
  deleted
  published
  deprecated
  archived
}

enum RelationType {
  extends
  references
  imports
  deprecated_by
}
